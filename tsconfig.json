{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "target": "es2020",
    "outDir": "out",
    "lib": [
      "es2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "typeRoots": [
      "./node_modules/@types",
      "./src/client/types"
    ],
    "strict": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test"
  ]
}