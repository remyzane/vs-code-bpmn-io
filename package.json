{
  "name": "vs-code-bpmn-io",
  "displayName": "BPMN.io Editor",
  "description": "Edit BPMN 2.0 files, powered by bpmn.io tools.",
  "license": "MIT",
  "version": "0.22.2-3",
  "publisher": "bpmn-io",
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/vs-code-bpmn-io"
  },
  "engines": {
    "vscode": "^1.79.2",
    "node": ">= 16"
  },
  "icon": "resources/logo_marketplace.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "bpmn"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [],
    "keybindings": [],
    "customEditors": [
      {
        "viewType": "bpmn-io.bpmnEditor",
        "displayName": "BPMN Editor",
        "selector": [
          {
            "filenamePattern": "*.bpmn"
          }
        ]
      }
    ]
  },
  "scripts": {
    "all": "run-s lint test",
    "lint": "eslint .",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce pack",
    "compile": "run-s compile:clean compile:app",
    "compile:app": "rollup -c rollup.config.mjs",
    "compile:clean": "shx rm -rf out",
    "watch:app": "npm run compile:app -- -w",
    "watch": "run-p watch:*",
    "pretest": "run-s compile",
    "test": "node ./out/test/run-tests.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-url": "^8.0.2",
    "@types/chai": "^5.2.3",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.0",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^4.0.0",
    "@types/vscode": "1.79.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "chai": "^6.2.2",
    "eslint": "^9.39.3",
    "eslint-plugin-bpmn-io": "^2.2.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.5",
    "npm-run-all2": "^8.0.4",
    "rollup": "^4.59.0",
    "rollup-plugin-css-only": "^4.5.5",
    "shx": "^0.3.4",
    "sinon": "^21.0.2",
    "sinon-chai": "^4.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.35",
    "bpmn-js": "^18.13.1",
    "bpmn-js-color-picker": "^0.7.2"
  }
}